<?xml version="1.0"?>
<launch>
  <!-- Stage 3: Moving obstacles - Dynamic environment training -->
  <!-- Robot spawning handled by put_robot_in_world.launch (called by TurtleBot3Env) -->

  <!-- Launch Gazebo with moving obstacles world -->
  <include file="$(find gazebo_ros)/launch/empty_world.launch">
    <arg name="world_name" value="$(find turtlebot3_gazebo)/worlds/stage3_moving_obstacles.world"/>
    <arg name="paused" value="false"/>
    <arg name="use_sim_time" value="true"/>
    <arg name="gui" value="true"/>
    <arg name="headless" value="false"/>
    <arg name="debug" value="false"/>
  </include>

  <!-- Moving obstacles node: moves cylinder models along waypoint paths -->
  <!-- Uses sim time so movement pauses/resumes with Gazebo pause/unpause -->
  <node pkg="turtlebot3_gazebo" type="moving_obstacles_node.py" name="moving_obstacles" output="screen">
    <param name="obstacle_speed" value="0.15"/>
    <param name="update_rate" value="30"/>
  </node>
</launch>
