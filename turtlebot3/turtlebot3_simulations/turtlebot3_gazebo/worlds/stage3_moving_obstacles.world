<?xml version="1.0" ?>
<sdf version="1.6">
  <world name="stage3_moving_obstacles">
    <!-- Stage 3: Bounded arena with static obstacles for obstacle avoidance training -->
    
    <!-- Global light source -->
    <include>
      <uri>model://sun</uri>
    </include>

    <!-- Ground plane -->
    <include>
      <uri>model://ground_plane</uri>
    </include>

    <!-- Physics settings -->
    <physics type="ode">
      <real_time_update_rate>1000.0</real_time_update_rate>
      <max_step_size>0.002</max_step_size>
      <real_time_factor>3</real_time_factor>
      <ode>
        <solver>
          <type>quick</type>
          <iters>20</iters>
          <sor>1.3</sor>
        </solver>
        <constraints>
          <cfm>0.00001</cfm>
          <erp>0.2</erp>
          <contact_max_correcting_vel>2000.000000</contact_max_correcting_vel>
          <contact_surface_layer>0.01000</contact_surface_layer>
        </constraints>
      </ode>
    </physics>

    <!-- Scene settings -->
    <scene>
      <ambient>0.4 0.4 0.4 1</ambient>
      <background>0.7 0.7 0.7 1</background>
      <shadows>false</shadows>
    </scene>

    <!-- Camera view -->
    <gui fullscreen='0'>
      <camera name='user_camera'>
        <pose>0 -8 8 0 0.7 1.57</pose>
        <view_controller>orbit</view_controller>
      </camera>
    </gui>

    <!-- BOUNDED ARENA: 4x4 meter box made of walls -->
    
    <!-- Wall 1: North (y = 2) -->
    <model name="wall_north">
      <static>true</static>
      <pose>0 2 0.5 0 0 0</pose>
      <link name="link">
        <collision name="collision">
          <geometry>
            <box>
              <size>4 0.2 1</size>
            </box>
          </geometry>
        </collision>
        <visual name="visual">
          <geometry>
            <box>
              <size>4 0.2 1</size>
            </box>
          </geometry>
          <material>
            <ambient>0.5 0.5 0.5 1</ambient>
            <diffuse>0.5 0.5 0.5 1</diffuse>
          </material>
        </visual>
      </link>
    </model>

    <!-- Wall 2: South (y = -2) -->
    <model name="wall_south">
      <static>true</static>
      <pose>0 -2 0.5 0 0 0</pose>
      <link name="link">
        <collision name="collision">
          <geometry>
            <box>
              <size>4 0.2 1</size>
            </box>
          </geometry>
        </collision>
        <visual name="visual">
          <geometry>
            <box>
              <size>4 0.2 1</size>
            </box>
          </geometry>
          <material>
            <ambient>0.5 0.5 0.5 1</ambient>
            <diffuse>0.5 0.5 0.5 1</diffuse>
          </material>
        </visual>
      </link>
    </model>

    <!-- Wall 3: East (x = 2) -->
    <model name="wall_east">
      <static>true</static>
      <pose>2 0 0.5 0 0 0</pose>
      <link name="link">
        <collision name="collision">
          <geometry>
            <box>
              <size>0.2 4 1</size>
            </box>
          </geometry>
        </collision>
        <visual name="visual">
          <geometry>
            <box>
              <size>0.2 4 1</size>
            </box>
          </geometry>
          <material>
            <ambient>0.5 0.5 0.5 1</ambient>
            <diffuse>0.5 0.5 0.5 1</diffuse>
          </material>
        </visual>
      </link>
    </model>

    <!-- Wall 4: West (x = -2) -->
    <model name="wall_west">
      <static>true</static>
      <pose>-2 0 0.5 0 0 0</pose>
      <link name="link">
        <collision name="collision">
          <geometry>
            <box>
              <size>0.2 4 1</size>
            </box>
          </geometry>
        </collision>
        <visual name="visual">
          <geometry>
            <box>
              <size>0.2 4 1</size>
            </box>
          </geometry>
          <material>
            <ambient>0.5 0.5 0.5 1</ambient>
            <diffuse>0.5 0.5 0.5 1</diffuse>
          </material>
        </visual>
      </link>
    </model>

    <!-- STATIC OBSTACLES: 3 square boxes inside arena -->
    
    <!-- Obstacle 1: Red box in upper-right quadrant -->
    <model name="obstacle_1">
      <static>true</static>
      <pose>0.8 0.8 0.3 0 0 0</pose>
      <link name="link">
        <collision name="collision">
          <geometry>
            <box>
              <size>0.3 0.3 0.6</size>
            </box>
          </geometry>
        </collision>
        <visual name="visual">
          <geometry>
            <box>
              <size>0.3 0.3 0.6</size>
            </box>
          </geometry>
          <material>
            <ambient>0.5 0.5 0.5 1</ambient>
            <diffuse>0.5 0.5 0.5 1</diffuse>
          </material>
        </visual>
      </link>
    </model>

    <!-- Obstacle 2: Blue box in lower-left quadrant -->
    <model name="obstacle_2">
      <static>true</static>
      <pose>-0.8 -0.8 0.3 0 0 0</pose>
      <link name="link">
        <collision name="collision">
          <geometry>
            <box>
              <size>0.3 0.3 0.6</size>
            </box>
          </geometry>
        </collision>
        <visual name="visual">
          <geometry>
            <box>
              <size>0.3 0.3 0.6</size>
            </box>
          </geometry>
          <material>
            <ambient>0.5 0.5 0.5 1</ambient>
            <diffuse>0.5 0.5 0.5 1</diffuse>
          </material>
        </visual>
      </link>
    </model>

    <!-- Obstacle 3: Green box in lower-right area -->
    <model name="obstacle_3">
      <static>true</static>
      <pose>0.8 -0.8 0.3 0 0 0</pose>
      <link name="link">
        <collision name="collision">
          <geometry>
            <box>
              <size>0.3 0.3 0.6</size>
            </box>
          </geometry>
        </collision>
        <visual name="visual">
          <geometry>
            <box>
              <size>0.3 0.3 0.6</size>
            </box>
          </geometry>
          <material>
            <ambient>0.5 0.5 0.5 1</ambient>
            <diffuse>0.5 0.5 0.5 1</diffuse>
          </material>
        </visual>
      </link>
    </model>

    <model name="obstacle_4">
      <static>true</static>
      <pose>-0.8 0.8 0.3 0 0 0</pose>
      <link name="link">
        <collision name="collision">
          <geometry>
            <box>
              <size>0.3 0.3 0.6</size>
            </box>
          </geometry>
        </collision>
        <visual name="visual">
          <geometry>
            <box>
              <size>0.3 0.3 0.6</size>
            </box>
          </geometry>
          <material>
            <ambient>0.5 0.5 0.5 1</ambient>
            <diffuse>0.5 0.5 0.5 1</diffuse>
          </material>
        </visual>
      </link>
    </model>

    <!-- Goal Marker -->
    <model name="goal_marker">
      <static>false</static>
      <pose>1.5 1.5 0.1 0 0 0</pose>
      <link name="link">
        <gravity>false</gravity>
        <kinematic>true</kinematic>  
          <!-- Collision geometry - made passthrough for sensors -->
        <collision name="collision">
          <laser_retro>0</laser_retro>
          <max_contacts>0</max_contacts>
          <geometry>
            <cylinder>
              <radius>0.1</radius>
              <length>0.1</length>
            </cylinder>
          </geometry>
          <surface>
            <contact>
              <collide_without_contact>true</collide_without_contact>
            </contact>
          </surface>
        </collision>

        <visual name="visual">
          <geometry>
            <cylinder>
              <radius>0.1</radius>
              <length>0.1</length>
            </cylinder>
          </geometry>
          <material>
            <ambient>0 1 0 0.8</ambient>
            <diffuse>0 1 0 0.8</diffuse>
            <specular>0 1 0 1</specular>
            <emissive>0 0.5 0 1</emissive>
          </material>
        </visual>
      </link>
    </model>

    <!-- MOVING OBSTACLES: 2 cylinders that move around the arena -->
    
    <!-- Moving Cylinder 1: Orange cylinder starting at bottom-left -->
    <actor name="moving_obstacle_1">
      <pose>-1.2 -1.2 0.3 0 0 0</pose>
      <script>
        <loop>true</loop>
        <delay_start>0</delay_start>
        <auto_start>true</auto_start>
        <!-- Rectangular path around the arena at 0.15 m/s -->
        <trajectory id="0" type="walking">
          <waypoint>
            <time>0</time>
            <pose>-1.2 -1.2 0.3 0 0 0</pose>
          </waypoint>
          <waypoint>
            <time>16</time>
            <pose>1.2 -1.2 0.3 0 0 0</pose>
          </waypoint>
          <waypoint>
            <time>32</time>
            <pose>1.2 1.2 0.3 0 0 0</pose>
          </waypoint>
          <waypoint>
            <time>48</time>
            <pose>-1.2 1.2 0.3 0 0 0</pose>
          </waypoint>
          <waypoint>
            <time>64</time>
            <pose>-1.2 -1.2 0.3 0 0 0</pose>
          </waypoint>
        </trajectory>
      </script>
      <link name="link">
        <collision name="collision">
          <geometry>
            <cylinder>
              <radius>0.1</radius>
              <length>0.6</length>
            </cylinder>
          </geometry>
        </collision>
        <visual name="visual">
          <geometry>
            <cylinder>
              <radius>0.1</radius>
              <length>0.6</length>
            </cylinder>
          </geometry>
          <material>
            <ambient>1 0.5 0 1</ambient>
            <diffuse>1 0.5 0 1</diffuse>
          </material>
        </visual>
      </link>
    </actor>

    <!-- Moving Cylinder 2: Purple cylinder starting at top-right (opposite direction) -->
    <actor name="moving_obstacle_2">
      <pose>1.2 1.2 0.3 0 0 0</pose>
      <script>
        <loop>true</loop>
        <delay_start>0</delay_start>
        <auto_start>true</auto_start>
        <!-- Rectangular path in opposite direction at 0.15 m/s -->
        <trajectory id="0" type="walking">
          <waypoint>
            <time>0</time>
            <pose>1.2 1.2 0.3 0 0 0</pose>
          </waypoint>
          <waypoint>
            <time>16</time>
            <pose>-1.2 1.2 0.3 0 0 0</pose>
          </waypoint>
          <waypoint>
            <time>32</time>
            <pose>-1.2 -1.2 0.3 0 0 0</pose>
          </waypoint>
          <waypoint>
            <time>48</time>
            <pose>1.2 -1.2 0.3 0 0 0</pose>
          </waypoint>
          <waypoint>
            <time>64</time>
            <pose>1.2 1.2 0.3 0 0 0</pose>
          </waypoint>
        </trajectory>
      </script>
      <link name="link">
        <collision name="collision">
          <geometry>
            <cylinder>
              <radius>0.1</radius>
              <length>0.6</length>
            </cylinder>
          </geometry>
        </collision>
        <visual name="visual">
          <geometry>
            <cylinder>
              <radius>0.1</radius>
              <length>0.6</length>
            </cylinder>
          </geometry>
          <material>
            <ambient>0.6 0.2 0.8 1</ambient>
            <diffuse>0.6 0.2 0.8 1</diffuse>
          </material>
        </visual>
      </link>
    </actor>

  </world>
</sdf>
