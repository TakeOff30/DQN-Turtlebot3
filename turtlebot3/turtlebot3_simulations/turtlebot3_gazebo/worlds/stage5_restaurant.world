            </cylinder>
          </geometry>
          <material>
            <ambient>0.2 0.4 0.9 1</ambient>
            <diffuse>0.2 0.4 0.9 1</diffuse>
          </material>
        </visual>
      </link>
    </model>

    <!-- Moving Cylinder 5: Yellow - circumnavigates tables clockwise from west corner -->
    <model name="moving_obstacle_5">
      <static>false</static>
      <pose>-2.2 2.0 0.3 0 0 0</pose>
      <link name="link">
