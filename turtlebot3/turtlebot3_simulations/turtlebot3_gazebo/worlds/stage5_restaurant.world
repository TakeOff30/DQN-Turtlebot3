            <cylinder>
              <radius>0.1</radius>
              <length>0.6</length>
            </cylinder>
          </geometry>
          <material>
            <ambient>0.6 0.2 0.8 1</ambient>
            <diffuse>0.6 0.2 0.8 1</diffuse>
          </material>
        </visual>
      </link>
    </model>

    <!-- Moving Cylinder 3: Red - circumnavigates tables clockwise -->
    <model name="moving_obstacle_3">
      <static>false</static>
      <pose>-2.2 -2.2 0.3 0 0 0</pose>
      <link name="link">
        <gravity>false</gravity>
        <kinematic>true</kinematic>
        <collision name="collision">
          <geometry>
            <cylinder>
              <radius>0.1</radius>
              <length>0.6</length>
            </cylinder>
