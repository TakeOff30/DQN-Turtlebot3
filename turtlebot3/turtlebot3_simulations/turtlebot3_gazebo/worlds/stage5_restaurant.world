        </visual>
      </link>
    </model>

    <model name="table_6">
      <static>true</static>
      <pose>1.5 1.5 0.375 0 0 0</pose>
      <link name="link">
        <collision name="collision">
          <geometry>
            <box>
              <size>0.5 0.5 0.5</size>
            </box>
          </geometry>
        </collision>
        <visual name="visual">
          <geometry>
